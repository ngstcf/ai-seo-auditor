# OpenAI-compatible API key (required)
LLM_API_KEY=your_api_key_here

# Custom API endpoint (optional, defaults to OpenAI)
LLM_BASE_URL=https://api.openai.com/v1

# Model to use (optional, defaults to gpt-4o-mini)
LLM_MODEL=gpt-4o-mini

# Crawl depth: 0 = landing page only, 1 = landing page + links on it, 2+ = deeper
MAX_DEPTH=1

# Maximum number of pages to analyze per audit
MAX_PAGES=5
